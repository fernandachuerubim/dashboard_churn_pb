	column Faixa_Idade =
			
			SWITCH(
			    TRUE(),
			    [Customer_Age] >= 26 && [Customer_Age] <= 32, "26-32",
			    [Customer_Age] >= 33 && [Customer_Age] <= 39, "33-39",
			    [Customer_Age] >= 40 && [Customer_Age] <= 46, "40-46",
			    [Customer_Age] >= 47 && [Customer_Age] <= 52, "47-52",
			    [Customer_Age] >= 53 && [Customer_Age] <= 58, "53-58",
			    BLANK()
			)
		lineageTag: bd489195-dc44-4cc1-9273-4fc4a015327f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

