table BankChurners
	lineageTag: ffe95e3f-ea37-45c2-bba3-a0ad2a0de255

	measure Existing_Customers =
			
			CALCULATE(
			    COUNTROWS(BankChurners),
			    KEEPFILTERS(
			        BankChurners[Attrition_Flag] = "Existing Customer"
			    )
			)
		formatString: 0
		lineageTag: dabaf76d-c4b0-40ad-80c1-91a057c53aee

	measure Attrited_Customers =
			
			CALCULATE(
			    COUNTROWS(BankChurners),
			    KEEPFILTERS(
			        BankChurners[Attrition_Flag] = "Attrited Customer"
			    )
			)
		formatString: 0
		lineageTag: a9c35c8d-9fba-4b94-8be6-9762b195d6a4

